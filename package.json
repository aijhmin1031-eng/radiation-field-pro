{
  "name": "radiation-field-pro",
  "type": "module",
  "private": true,
  "description": "Professional X-ray/gamma reference-field characterization and dosimetry (ISO 4037).",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-pages.mjs && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview",
    "sync-shell": "node scripts/sync-shell.mjs",
    "check-shell": "node gate/check-shell.mjs",
    "gate": "npm run build && npm run check-shell",
    "test": "tsx --test src/engine/*.test.ts src/validation/*.test.ts src/app/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "report:accuracy": "tsx scripts/gen-accuracy-report.ts",
    "e2e": "playwright test",
    "ci": "npm run typecheck && npm test && npm run gate && npm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5"
  }
}
